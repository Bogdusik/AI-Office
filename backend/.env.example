DATABASE_URL=postgresql+asyncpg://ai_office:change-me@localhost:5433/ai_office
CORS_ORIGINS=["http://localhost:3000"]
TEST_DATABASE_URL=postgresql+asyncpg://ai_office:change-me@localhost:5433/ai_office_test

# Background task executor (fake work until stage 6); durations in seconds
EXECUTOR_ENABLED=true
# Trips from the map edge to the desk and back; the scene animation fits into these exactly
EXECUTOR_ARRIVE_SECONDS=75
EXECUTOR_STAGE_SECONDS=5
EXECUTOR_DEPART_SECONDS=75
# A departing car stays in its spot this long: a task before it turns the agent back to the desk, a later one
# lets the car drive to the map edge and come straight back. A return lasts the time spent leaving + the extra.
EXECUTOR_TURN_BACK_SECONDS=50
EXECUTOR_RETURN_EXTRA_SECONDS=12
# «Отпустить всех» lets people go this far apart (the exit barrier passes one car at a time)
EXECUTOR_RELEASE_GAP_SECONDS=5
EXECUTOR_TICK_SECONDS=1
EXECUTOR_PROGRESS_SECONDS=1
# fake = placeholder text; llm = local model via Ollama
EXECUTOR_WORKER=fake

# Ollama (EXECUTOR_WORKER=llm); an agent's `model` field overrides OLLAMA_MODEL
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=true
OLLAMA_TEMPERATURE=0.3
# requests sent to the model at the same time (GPU queue), stage timeout counted from sending, retries after a failure
LLM_CONCURRENCY=1
LLM_STAGE_TIMEOUT_SECONDS=300
LLM_RETRIES=1
# part of the context window kept free for the answer: at least LLM_RESERVE_TOKENS, and room for thinking
# (LLM_THINK_TOKENS, when OLLAMA_THINK=true) plus the expected answer (self-check: the size of the draft it rewrites)
LLM_RESERVE_TOKENS=6144
LLM_THINK_TOKENS=6144
# Research stage with web tools (agents with web access only); SearXNG runs in docker-compose
LLM_RESEARCH_TIMEOUT_SECONDS=900
SEARXNG_URL=http://127.0.0.1:8888
WEB_MAX_TOOL_CALLS=8
WEB_MAX_PAGES=4
WEB_PAGE_CHARS=4000
WEB_MAX_BYTES=2000000
WEB_TOOL_TIMEOUT_SECONDS=15
WEB_SEARCH_RESULTS=8

# Job search tools (agents with the "jobs" tool): Adzuna (https://developer.adzuna.com) and Reed
# (https://www.reed.co.uk/developers/jobseeker). Secrets: never commit them. A source without keys is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# search_jobs + get_job calls per task (all versions), cache of identical searches (s), API timeout (s)
JOBS_MAX_CALLS=10
JOBS_CACHE_SECONDS=600
JOBS_TIMEOUT_SECONDS=15
JOBS_MAX_RESULTS=50
